{
  "seed": 42,
  "input_size": 132,
  "hidden_size": 64,
  "num_layers": 1,
  "batch_size": 8,
  "optimizer": "Adam",
  "learning_rate": 0.001,
  "weight_decay": 0.0001,
  "loss": "BCEWithLogitsLoss",
  "max_epochs": 50,
  "early_stopping_patience": 8,
  "selection_criterion": "validation_loss",
  "classification_threshold": 0.5,
  "preprocessing": {
    "normalize_pose": false,
    "max_forward_fill_frames": 5,
    "epsilon": 1e-06
  }
}
